# Local demo only. Replace values before starting. Never commit the real .env.
POSTGRES_PASSWORD=choose-a-long-local-database-password
DEMO_PASSWORD=choose-a-local-demo-password
WEBHOOK_SECRET=choose-a-random-secret-at-least-32-characters
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
HOLD_SECONDS=300
ENABLE_SANDBOX=true

# Provider sandbox integration (disabled until your own credentials are supplied)
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_CALLBACK_ORIGIN=http://localhost:3000
SSLCOMMERZ_ENABLED=false
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
BKASH_ENABLED=false
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
